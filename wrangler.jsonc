{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yramp-company-website",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "314159",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
